# ── Keycloak (Identity Provider) ────────────────────────────────────────────
# Public Keycloak base URL — must be reachable by the browser.
# When fronted by Caddy the /auth path is reverse-proxied to Keycloak so the
# SPA and the IdP share one origin (avoids third-party cookie / CORS issues).
VITE_KEYCLOAK_URL=https://crm.example.com/auth
VITE_KEYCLOAK_REALM=chiefvoice
VITE_KEYCLOAK_CLIENT_ID=chiefvoice-crm

# ── Backend API ───────────────────────────────────────────────────────────────
# Leave empty when the frontend is served from the same origin as the API
# (Caddy handles the /api proxy). Set to a full URL only for separate deploys.
VITE_API_URL=

# ── Environment tag ─────────────────────────────────────────────────────────
# Set to "dev" only on the dev/staging deployment to reveal dev-only UI (e.g.
# Agent Studio's System Agents tab). Leave unset in production — this is a
# build-time value (baked into the bundle by `vite build`), not something a
# user can flip at runtime.
VITE_APP_ENV=
